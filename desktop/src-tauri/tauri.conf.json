{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LedgerFlow",
  "version": "0.1.0",
  "identifier": "com.ledgerflow.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LedgerFlow",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "maximized": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Finance",
    "shortDescription": "Private business ledger and account statements",
    "longDescription": "LedgerFlow is a local-first business ledger for companies, parties, transactions, reports, encrypted backups, and attachments.",
    "resources": {
      "resources/runtime/": "runtime/",
      "resources/backend/ledgerflow-backend.jar": "backend/ledgerflow-backend.jar"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
